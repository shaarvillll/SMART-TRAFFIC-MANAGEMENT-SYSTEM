# Auto-detect text files and normalize line endings to LF on commit
* text=auto

# Source files & configurations (LF in repository and on POSIX)
*.dart text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Executable shell scripts (always LF)
*.sh text eol=lf
gradlew text eol=lf

# Windows batch files (must use CRLF when checked out on Windows)
*.bat text eol=crlf
*.cmd text eol=crlf

# Explicitly mark binary files to prevent line ending manipulation
*.jar binary
*.png binary
*.docx binary
*.ico binary
